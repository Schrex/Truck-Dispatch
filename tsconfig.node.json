{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "tailwind.config.ts", "playwright.config.ts", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["scripts/**/*.test.mjs"]
}
